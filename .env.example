# Microsoft Foundry project and model deployment
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# azure.yaml / Azure Developer CLI alias; use the same project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=your-model-deployment-name

# Recommended Foundry IQ Search access: name of the Search connection in the project
FOUNDRY_IQ_SEARCH_CONNECTION_NAME=your-search-connection-name
# Hosted-agent alias used by azure.yaml
AZURE_AI_SEARCH_CONNECTION_NAME=your-search-connection-name

# Alternative Search access: direct endpoint with AzureCliCredential
# FOUNDRY_IQ_SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# Optional resource-name overrides
# FOUNDRY_IQ_OPPORTUNITY_INDEX_NAME=si-healthcare-opportunity-history
# FOUNDRY_IQ_OPPORTUNITY_KNOWLEDGE_SOURCE_NAME=si-healthcare-opportunity-history-ks
# FOUNDRY_IQ_OPPORTUNITY_KNOWLEDGE_BASE_NAME=si-healthcare-opportunity-assessment-kb
# FOUNDRY_IQ_PROPOSAL_INDEX_NAME=si-healthcare-opportunity-proposals
# FOUNDRY_IQ_PROPOSAL_KNOWLEDGE_SOURCE_NAME=si-healthcare-opportunity-proposals-ks
# FOUNDRY_IQ_PROPOSAL_KNOWLEDGE_BASE_NAME=si-healthcare-opportunity-proposals-kb

# Hybrid retrieval embeddings and agentic query-planning model
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
# FOUNDRY_IQ_PLANNER_MODEL_NAME=gpt-5.2

# Optional Azure Blob Storage output for Demo 2; otherwise files go to outputs/
# AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
# AZURE_STORAGE_PROPOSAL_CONTAINER_NAME=opportunity-proposals

# Optional telemetry export for Demo 4
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=replace-me
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317